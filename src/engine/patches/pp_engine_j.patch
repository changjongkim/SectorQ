+  // A row for strings at position k that divides a piece of m terms; ones(r) counts the terms of odd parity with r.
+  // First the spare row drawn as before (the only one tried earlier, so runs whose first row divides are unchanged),
+  // then the other spare rows; if none divides (the terms lie in one coset of the window's generators), rows that only
+  // the operations k..e-1 conserve: the most even of 32 random ones, else of their basis. Without a dividing row the
+  // run stops with a message instead of requeueing the same piece again (pp_engine_i repeated it without end).
+  template <class F> BV divideRow(const Window& w, Shared& sh, int k, long m, F ones) {
+    if (w.spare.empty()) die("window has no row left to split a bucket", __LINE__);
+    const size_t first = rng() % w.spare.size();
+    for (size_t j = 0; j < w.spare.size(); j++) {
+      BV r = spareAt(w, first + j, k);
+      const long c = ones(r);
+      if (c > 0 && c < m) { if (j) sh.rowRetries++; return r; }
+    }
+    sh.rowRetries++;
+    const std::vector<BV> ann = annihilatorFrom(k, w.e);
+    const int W = g_L.words();
+    BV best;
+    long bestMin = 0;
+    auto consider = [&](const BV& r) {
+      const long c = ones(r), mn = std::min(c, m - c);
+      if (mn > bestMin) { bestMin = mn; best = r; }
+    };
+    for (int t = 0; t < 32 && !ann.empty() && bestMin * 4 < m; t++) {
+      BV r(W, 0);
+      bool any = false;
+      while (!any)
+        for (auto& a : ann) if (rng() & 1ULL) { any = true; for (int x = 0; x < W; x++) r[x] ^= a[x]; }
+      consider(r);
+    }
+    for (size_t j = 0; j < ann.size() && bestMin == 0; j++) consider(ann[j]);
+    if (bestMin == 0) {
+      fprintf(stderr, "[node %d] operation %d: none of the rows conserved by operations %d..%d divides a piece of %ld terms\n",
+              g_rank, k, k, w.e - 1, m);
+      die("no row divides an overflowing piece", __LINE__);
+    }
+    sh.laterRows++;
+    fprintf(stderr, "[node %d] operation %d: piece of %ld terms split by a row of operations %d..%d (%ld : %ld)\n",
+            g_rank, k, m, k, w.e - 1, bestMin, m - bestMin);
+    return best;
+  }
