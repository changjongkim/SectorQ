+// Rows for strings at position k that the branching rotations of operations [k, e) conserve: the annihilator of
+// their generators as seen from position k (built as in planWindow). A window's own rows are conserved over [b, e);
+// these rows are a superset, since fewer generators remain. They divide a piece whose terms all lie in one coset of
+// the window's generators (the descendants of one input string), which no row of the window can divide.
+static std::vector<BV> annihilatorFrom(int k, int e) {
+  Span V; V.L = g_L;
+  std::vector<int> maps;
+  for (int j = k; j < e; j++) {
+    const Op& op = g_ops[j];
+    if (op.type == OP_ROT && op.branches) {
+      BV v = op.gen;
+      for (int i = (int)maps.size() - 1; i >= 0; --i) mapVec(g_ops[maps[i]], v.data(), g_L);
+      V.add(v);
+    } else if (changesBits(op)) {
+      maps.push_back(j);
+    }
+  }
+  return V.annihilator();
+}
